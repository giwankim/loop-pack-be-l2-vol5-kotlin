#!/usr/bin/env python3
"""Check a design doc edit against a base revision: notes are insert-only and section references resolve.

Usage: scripts/check-doc-notes BASE FILE [FILE ...]

For each FILE (a path in the repo), compares `git show BASE:FILE` with the working tree.

- Insert-only: every line of BASE that the edit touched must still appear, character by character
  and in order, inside one of the lines that replaced it. A dated note appended to a sentence passes;
  a reworded sentence is reported as CHANGED. A reported line may be a deliberate edit (a status cell);
  the report is for a person to judge.
- References: every section number cited in an added line (`12.3`, `17절`) must be a heading of FILE
  (`## 17.`, `### 12.3`). Numbers inside code spans, right after a link (`[catalog design](…) 5.17`
  points into another doc), and right after a capitalized word (`Boot 4.1`) are skipped.

Exits 1 when anything is reported.
"""

import difflib
import re
import subprocess
import sys
from pathlib import Path

HEADING = re.compile(r"^#{2,3} (\d+(?:\.\d+)?)\.? ", re.M)
SECTION_REF = re.compile(r"(?<![\d.])(\d{1,2}\.\d{1,2})(?![\d.]| ?m?s\b)|(?<![\d.])(\d{1,2})절")


def git_show(base: str, path: str) -> str:
    return subprocess.run(["git", "show", f"{base}:{path}"], check=True, capture_output=True, text=True).stdout


def survives_in(old: str, new: str) -> bool:
    matcher = difflib.SequenceMatcher(None, old, new, autojunk=False)
    return sum(block.size for block in matcher.get_matching_blocks()) == len(old)


def changed_lines(old_lines, new_lines):
    matcher = difflib.SequenceMatcher(None, old_lines, new_lines, autojunk=False)
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag not in ("replace", "delete"):
            continue
        replacements = new_lines[j1:j2]
        for number, old in enumerate(old_lines[i1:i2], start=i1 + 1):
            if not any(survives_in(old, new) for new in replacements):
                yield number, old


def added_lines(old_lines, new_lines):
    matcher = difflib.SequenceMatcher(None, old_lines, new_lines, autojunk=False)
    for tag, _, _, j1, j2 in matcher.get_opcodes():
        if tag in ("replace", "insert"):
            yield from enumerate(new_lines[j1:j2], start=j1 + 1)


def unresolved_refs(line: str, headings):
    text = re.sub(r"`[^`]*`", "``", line)
    text = re.sub(r"\]\([^)]*\) ?\d{1,2}\.\d{1,2}", "]", text)
    text = re.sub(r"\b[A-Z][A-Za-z0-9]* \d{1,2}\.\d{1,2}", "", text)
    text = re.sub(r"\]\([^)]*\)", "]", text)
    for match in SECTION_REF.finditer(text):
        ref = match.group(1) or match.group(2)
        if ref not in headings:
            yield ref


def check(base: str, path: str) -> int:
    old_lines = git_show(base, path).splitlines()
    new_text = Path(path).read_text(encoding="utf-8")
    new_lines = new_text.splitlines()
    headings = set(HEADING.findall(new_text))
    problems = 0

    for number, old in changed_lines(old_lines, new_lines):
        print(f"{path}:{number} CHANGED (base line): {old[:160]}")
        problems += 1
    for number, line in added_lines(old_lines, new_lines):
        for ref in unresolved_refs(line, headings):
            print(f"{path}:{number} UNRESOLVED {ref}: {line[:120]}")
            problems += 1
    return problems


def main() -> int:
    if len(sys.argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    base, paths = sys.argv[1], sys.argv[2:]
    problems = sum(check(base, path) for path in paths)
    print(f"{problems} problem(s)" if problems else "ok")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
